# ACE Electronics — environment variables
#
# Copy this file to `.env.local` and fill in the real values:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Both variables below are NEXT_PUBLIC_*, meaning they are inlined into the
# client bundle and are visible to anyone who views the site. That is expected
# and safe for these two values ONLY:
#
#   * The project URL is public by design.
#   * The publishable (anon) key identifies the project, it does not grant
#     access. Every request it makes is still evaluated against the project's
#     Row Level Security policies.
#
# NEVER put the service-role key in a NEXT_PUBLIC_* variable — it bypasses RLS
# entirely. This project does not use a service-role key at all.

NEXT_PUBLIC_SUPABASE_URL=https://dqaxoucjspidvurgdqrf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
